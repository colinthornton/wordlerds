{
  "scripts": {
    "dev": "bun run concurrently 'bun dev:server' 'bun dev:css' 'bun dev:js'",
    "dev:server": "bun run --hot src/index.ts",
    "dev:css": "bun run tailwindcss -i src/public/wordlerds.css -o public/wordlerds.css --watch",
    "dev:js": "bun build src/public/wordlerds.ts --outdir public/ --watch",
    "build": "bun run --parallel build:css build:js",
    "build:css": "bun run tailwindcss -i src/public/wordlerds.css -o public/wordlerds.css",
    "build:js": "bun build src/public/wordlerds.ts --outdir public/",
    "db": "bun run --bun kysely",
    "migrate:latest": "bun run scripts/migrate.ts"
  },
  "dependencies": {
    "@starfederation/datastar-sdk": "^1.0.0-RC.3",
    "better-auth": "^1.5.6",
    "hono": "^4.12.10",
    "kysely": "^0.28.15",
    "kysely-bun-sqlite": "^0.4.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.2.2",
    "@types/bun": "^1.3.11",
    "basecoat-css": "^0.3.11",
    "concurrently": "^9.2.1",
    "kysely-ctl": "^0.20.0",
    "tailwindcss": "^4.2.2"
  },
  "trustedDependencies": [
    "@parcel/watcher"
  ]
}
